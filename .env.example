APP_NAME=SwarUtsav
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
TOKEN_TTL_SECONDS=3600
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
DATABASE_PATH=./data/swarutsav.db
REACT_APP_API_URL=http://localhost:8000/api/v1

# Optional AI: server-side only; leave unset for rule-based fallback.
XAI_API_KEY=
GROK_MODEL=grok-4
# Optional local Whisper: install faster-whisper separately and set ENABLE_WHISPER=true.
ENABLE_WHISPER=false
WHISPER_MODEL=tiny
RECORDING_PATH=./data/recordings
